DOCAGENT_PROFILE=qlh
DOCAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
DOCAGENT_OLLAMA_MODEL=gemma4:12b
DOCAGENT_CONFIDENCE_FLOOR=0.6

